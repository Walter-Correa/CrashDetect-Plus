#include <winresrc.h>
#include "pluginversion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CRASHDETECT_PLUS_VERSION_MAJOR,CRASHDETECT_PLUS_VERSION_MINOR,CRASHDETECT_PLUS_VERSION_PATCH,0
 PRODUCTVERSION CRASHDETECT_PLUS_VERSION_MAJOR,CRASHDETECT_PLUS_VERSION_MINOR,CRASHDETECT_PLUS_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Walter Correa"
            VALUE "FileDescription", "CrashDetect Plus - Zero-Overhead Diagnostic Engine for SA-MP & open.mp"
            VALUE "FileVersion", CRASHDETECT_PLUS_VERSION_STRING
            VALUE "InternalName", "crashdetect_plus"
            VALUE "LegalCopyright", "Copyright (c) 2026 Walter Correa (MPL-2.0); Portions (c) 2011-2021 Zeex & Y-Less"
            VALUE "OriginalFilename", "crashdetect_plus.dll"
            VALUE "ProductName", "CrashDetect Plus"
            VALUE "ProductVersion", CRASHDETECT_PLUS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
